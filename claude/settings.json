{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/no-var-expansion.py" },
          { "type": "command", "command": "~/.claude/hooks/deny-text-tools.py" },
          { "type": "command", "command": "~/.claude/hooks/deny-complex-commands.py" },
          { "type": "command", "command": "~/.claude/hooks/deny-venv-bin.py" }
        ]
      }
    ]
  }
}
